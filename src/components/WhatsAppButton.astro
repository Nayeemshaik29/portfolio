---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const text = encodeURIComponent("Hi Nayeem, I found your portfolio and I'd like to talk about a service.");
const href = `https://wa.me/${profile.whatsapp}?text=${text}`;
---
<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Chat on WhatsApp"
  class="group fixed right-4 bottom-4 z-[60] inline-flex items-center gap-2 rounded-full border border-white/10 bg-card/80 p-3 text-sm font-medium shadow-2xl backdrop-blur-xl transition hover:-translate-y-0.5 hover:border-[#25d366]/50 sm:pr-4 print:hidden"
>
  <span class="grid size-7 place-items-center rounded-full bg-[#25d366] text-[#06260f]"><Icon name="whatsapp" size={17} /></span>
  <span class="hidden sm:inline">Chat on WhatsApp</span>
</a>
