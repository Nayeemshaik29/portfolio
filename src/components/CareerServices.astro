---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { careerServices, bookingLinks } from '../data/services';

// Razorpay Payment Page when configured, otherwise a pre-filled booking email.
function bookHref(key: string, title: string, price: string) {
  if (bookingLinks[key]) return bookingLinks[key];
  const subject = 'Booking: ' + title + ' (' + price + ')';
  const body =
    'Hi Nayeem,\n\nI would like to book: ' + title + ' (' + price + ').\n\n' +
    'Name:\nPhone / WhatsApp:\nTarget role:\nLinkedIn URL:\n\n(Attach your current resume if you have one.)\n';
  return 'mailto:' + profile.email + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
}
function waHref(title: string, price: string) {
  const text = 'Hi Nayeem, I am interested in your ' + title + ' (' + price + ') service. Can we talk?';
  return 'https://wa.me/' + profile.whatsapp + '?text=' + encodeURIComponent(text);
}
---
<div class="grid gap-5 lg:grid-cols-3">
  {careerServices.map((s, i) => (
    <article
      class:list={[
        'spotlight reveal relative flex flex-col rounded-2xl border bg-card/60 p-7 transition duration-500 hover:-translate-y-1',
        s.badge ? 'border-white/25 bg-gradient-to-b from-white/[0.07] to-card/60 shadow-[0_30px_80px_-30px_rgba(255,255,255,.25)]' : 'hover:border-white/20',
      ]}
      data-delay={i * 90}
    >
      {s.badge && <span class="absolute -top-3 left-7 rounded-full bg-primary px-3 py-0.5 font-mono text-[11px] text-primary-foreground">{s.badge}</span>}
      <span class="grid size-11 place-items-center rounded-xl border bg-secondary"><Icon name={s.icon} size={20} /></span>
      <h3 class="mt-5 text-xl font-semibold tracking-tight">{s.title}</h3>
      <p class="mt-2 text-sm text-muted-foreground">{s.blurb}</p>
      <div class="mt-6 flex items-baseline gap-2">
        <span class="text-5xl font-semibold tracking-tighter">{s.price}</span>
        <span class="text-sm text-muted-foreground">one-time</span>
      </div>
      <p class="mt-2 flex items-center gap-2 font-mono text-xs text-muted-foreground"><Icon name="clock" size={13} /> {s.delivery}</p>
      <ul class="mt-6 grid flex-1 gap-2.5 text-sm">
        {s.includes.map((x) => <li class="flex gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-muted-foreground" /> {x}</li>)}
      </ul>
      <a
        href={bookHref(s.key, s.title, s.price)}
        class:list={[
          'mt-7 inline-flex h-11 items-center justify-center gap-2 rounded-full font-medium transition hover:-translate-y-0.5',
          s.badge ? 'bg-primary text-primary-foreground shadow-[0_8px_30px_-8px_rgba(255,255,255,.4)]' : 'border bg-background/40 hover:bg-accent',
        ]}
      >Book now · {s.price}</a>
      <a href={waHref(s.title, s.price)} target="_blank" rel="noopener" class="mt-3 text-center text-xs text-muted-foreground transition hover:text-foreground">Questions? Ask on WhatsApp</a>
    </article>
  ))}
</div>
<p class="reveal mt-8 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-sm text-muted-foreground">
  <Icon name="lock" size={14} /> Secure checkout by Razorpay · UPI, cards &amp; net banking · Receipt by email · Reply within 24 hours
</p>
