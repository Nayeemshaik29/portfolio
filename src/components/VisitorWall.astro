---
// Public totals + opted-in names. Stays hidden until the API returns data.
---
<section id="visitors" hidden class="section-y pt-0">
  <div class="container-x">
    <div class="reveal in rounded-3xl border bg-card/40 p-8 sm:p-12">
      <p class="eyebrow">06 · Visitors</p>
      <h2 class="h-section mt-5">Thanks for stopping by.</h2>
      <div class="mt-8 grid max-w-md grid-cols-2 gap-3">
        <div class="rounded-2xl border bg-background/50 p-5"><span id="w-views" class="block text-4xl font-semibold tracking-tighter">0</span><span class="text-sm text-muted-foreground">visits</span></div>
        <div class="rounded-2xl border bg-background/50 p-5"><span id="w-hi" class="block text-4xl font-semibold tracking-tighter">0</span><span class="text-sm text-muted-foreground">people said hi</span></div>
      </div>
      <div id="w-people-wrap" hidden class="mt-8">
        <p class="font-mono text-xs tracking-widest text-muted-foreground uppercase">Visitors who chose to be shown</p>
        <ul id="w-people" class="mt-4 flex flex-wrap gap-2"></ul>
      </div>
      <p class="mt-8 text-xs text-muted-foreground">Names appear only when a visitor ticks the box. Everyone else stays private.</p>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('#visitors');
  const flag = (c: string) => (c && c.length === 2 ? String.fromCodePoint(...[...c.toUpperCase()].map((x) => 127397 + x.charCodeAt(0))) : '🌐');
  const count = (el: HTMLElement, to: number) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || to < 2) return void (el.textContent = String(to));
    const t0 = performance.now();
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / 1400);
      el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (sec) {
    fetch('/api/wall')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d: { views: number; hi: number; people: { name: string; org: string; country: string }[] }) => {
        sec.hidden = false;
        const io = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          count(document.querySelector<HTMLElement>('#w-views')!, d.views);
          count(document.querySelector<HTMLElement>('#w-hi')!, d.hi);
        });
        io.observe(sec);
        if (d.people.length) {
          document.querySelector<HTMLElement>('#w-people-wrap')!.hidden = false;
          document.querySelector('#w-people')!.replaceChildren(
            ...d.people.map((p) => {
              const li = document.createElement('li');
              li.className = 'rounded-full border bg-background/50 px-3.5 py-1.5 text-sm';
              li.textContent = `${flag(p.country)} ${p.name}${p.org ? ' · ' + p.org : ''}`;
              return li;
            }),
          );
        }
      })
      .catch(() => {});
  }
</script>
