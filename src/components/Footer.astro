---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container inner">
    <p class="muted">© {year} {profile.name}. Built with Astro, deployed on Vercel.</p>
    <div class="links">
      <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a>
      <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
      <a href={profile.links.leetcode} target="_blank" rel="noopener" aria-label="LeetCode"><Icon name="leetcode" /></a>
      <a href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" /></a>
      <a href="/rss.xml" class="mono rss">RSS</a>
    </div>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--border); padding: 28px 0; font-size: .92rem; }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .inner p { margin: 0; }
  .links { display: flex; align-items: center; gap: 6px; }
  .links a {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; color: var(--text-muted);
    transition: color .2s, background .2s;
  }
  .links a:hover { color: var(--accent); background: var(--bg-soft); }
  .rss { width: auto !important; padding: 0 10px; font-size: .8rem; }
</style>
