---
import Icon from './Icon.astro';
interface Props { slug: string; title: string; description: string; date: Date; tags: string[]; minutes: number; delay?: number }
const { slug, title, description, date, tags, minutes, delay = 0 } = Astro.props;
const fmt = date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class="spotlight reveal group relative flex flex-col gap-3 rounded-2xl border bg-card/60 p-6 transition duration-500 hover:-translate-y-1 hover:border-white/20" data-delay={delay}>
  <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
    <time datetime={date.toISOString()}>{fmt}</time><span>·</span>
    <span class="inline-flex items-center gap-1"><Icon name="clock" size={12} /> {minutes} min</span>
  </div>
  <h3 class="text-lg leading-snug font-semibold tracking-tight">
    <a href={`/blog/${slug}`} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class="flex-1 text-sm text-muted-foreground">{description}</p>
  <div class="flex flex-wrap gap-1.5">{tags.slice(0, 3).map((t) => <span class="font-mono text-[11px] text-muted-foreground">#{t}</span>)}</div>
  <Icon name="arrow" size={18} class="absolute top-6 right-6 -rotate-45 text-muted-foreground transition group-hover:rotate-0 group-hover:text-foreground" />
</article>
