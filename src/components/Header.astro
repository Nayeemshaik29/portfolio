---
import Icon from './Icon.astro';
import MobileNav from './react/MobileNav';
import { profile } from '../data/profile';

const nav = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Work' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contact', label: 'Contact' },
];
const path = Astro.url.pathname;
const onFreelance = path.startsWith('/freelance');
---
<header class="sticky top-0 z-50 pt-3" data-header>
  <div class="container-x">
    <div class="flex h-14 items-center justify-between gap-3 rounded-full border border-transparent px-2 pl-4 transition-all duration-300 [[data-scrolled]_&]:border-border [[data-scrolled]_&]:bg-background/70 [[data-scrolled]_&]:shadow-2xl [[data-scrolled]_&]:backdrop-blur-xl">
      <a href="/" class="group flex items-center gap-2.5" aria-label={`${profile.name} — home`}>
        <span class="grid size-8 place-items-center rounded-lg border bg-card font-mono text-[11px] font-bold transition group-hover:rotate-6">NS</span>
        <span class="hidden font-medium tracking-tight sm:inline">{profile.name}</span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
        {nav.map((n) => (
          <a
            href={n.href}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm transition hover:bg-accent hover:text-foreground',
              n.href === path || (n.href === '/blog' && path.startsWith('/blog')) ? 'text-foreground' : 'text-muted-foreground',
            ]}
          >{n.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="/freelance"
          class:list={[
            'group relative hidden h-9 items-center gap-2 overflow-hidden rounded-full border px-4 text-sm font-medium transition sm:inline-flex',
            onFreelance ? 'bg-primary text-primary-foreground' : 'bg-card hover:border-white/25',
          ]}
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-success"></span>
          </span>
          Freelance
        </a>
        <a href="/resume.pdf" target="_blank" rel="noopener" class="hidden h-9 items-center gap-2 rounded-full bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:-translate-y-0.5 md:inline-flex">
          <Icon name="download" size={15} /> Resume
        </a>
        <MobileNav client:load items={[{ href: '/', label: 'Home' }, ...nav, { href: '/freelance', label: 'Freelance' }]} path={path} />
      </div>
    </div>
  </div>
</header>

<script>
  const onScroll = () => document.documentElement.toggleAttribute('data-scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
