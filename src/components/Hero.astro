---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---
<section class="hero">
  <div class="bg-grid"></div>
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>

  <div class="container hero-grid">
    <div class="copy">
      <p class="status mono"><span class="dot"></span> Open to backend roles · {profile.location}</p>
      <h1>
        Hi, I'm {profile.shortName}.<br />
        <span class="gradient-text">I build backends that don't break.</span>
      </h1>
      <p class="lead">{profile.role} working with <strong>Java</strong>, <strong>Spring Boot</strong>, <strong>microservices</strong> and <strong>Kafka</strong>. {profile.pitch}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#projects">View my work <Icon name="arrow" /></a>
        <a class="btn" href="/blog"><Icon name="book" /> Read the blog</a>
        <a class="btn ghost" href="/resume.pdf" target="_blank" rel="noopener"><Icon name="download" /> Resume</a>
      </div>
      <div class="socials">
        <a href={profile.links.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={20} /></a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
        <a href={profile.links.leetcode} target="_blank" rel="noopener" aria-label="LeetCode"><Icon name="leetcode" size={20} /></a>
        <a href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" size={20} /></a>
      </div>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="window">
        <div class="win-bar">
          <span></span><span></span><span></span>
          <p class="mono">TransferService.java</p>
        </div>
<pre class="code mono"><span class="c">// money moves once — even if the client retries</span>
<span class="k">@Transactional</span>
<span class="k">public</span> Transfer <span class="f">initiate</span>(TransferRequest req, String idemKey) &#123;
  <span class="k">return</span> idempotency.<span class="f">findResult</span>(idemKey)
    .<span class="f">orElseGet</span>(() -&gt; &#123;
      var t = accounts.<span class="f">debit</span>(req);          <span class="c">// @Version lock</span>
      outbox.<span class="f">save</span>(<span class="s">"transfer.initiated"</span>, t); <span class="c">// same tx</span>
      <span class="k">return</span> idempotency.<span class="f">store</span>(idemKey, t);
    &#125;);
&#125;<span class="cursor"></span></pre>
      </div>

      <div class="float f1 mono"><span class="ok"></span> Kafka · exactly-once effect</div>
      <div class="float f2 mono"><span class="ok"></span> Saga · auto-compensation</div>
      <div class="avatar-card">
        <img src="/avatar.jpg" alt="" width="64" height="64" loading="eager" />
        <div>
          <strong>{profile.name}</strong>
          <span class="mono">Associate SWE @ LTM</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(56px, 9vw, 110px) 0 clamp(64px, 9vw, 120px); overflow: hidden; }
  .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .55; pointer-events: none; }
  .orb-a { width: 460px; height: 460px; background: var(--accent); top: -160px; left: -140px; opacity: .18; }
  .orb-b { width: 520px; height: 520px; background: var(--accent-3); top: 40px; right: -200px; opacity: .16; }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }

  .hero-grid > * { min-width: 0; }
  .status {
    display: inline-flex; align-items: center; gap: 10px; font-size: .8rem; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--border); background: color-mix(in srgb, var(--bg-elev) 70%, transparent); color: var(--text-muted);
    margin-bottom: 22px;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 var(--accent); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); } 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  h1 { font-size: clamp(2.3rem, 4.8vw, 3.7rem); font-weight: 800; letter-spacing: -0.035em; margin-bottom: 22px; }
  .lead { font-size: clamp(1.02rem, 1.6vw, 1.18rem); color: var(--text-muted); max-width: 560px; margin-bottom: 30px; }
  .lead strong { color: var(--text); font-weight: 600; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .ghost { background: transparent; }
  .socials { display: flex; gap: 8px; }
  .socials a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--border);
    color: var(--text-muted); transition: color .2s, border-color .2s, transform .2s;
  }
  .socials a:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-2px); }

  .visual { position: relative; }
  .window {
    border-radius: var(--radius-lg); background: #100e0b; border: 1px solid #2a2620; box-shadow: var(--shadow-lg);
    overflow: hidden; transform: perspective(1400px) rotateY(-6deg) rotateX(3deg); transition: transform .6s var(--ease);
  }
  .visual:hover .window { transform: none; }
  .win-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid #221e18; background: #16130f; }
  .win-bar span { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .win-bar span:nth-child(2) { background: #febc2e; }
  .win-bar span:nth-child(3) { background: #28c840; }
  .win-bar p { margin: 0 0 0 10px; font-size: .78rem; color: #80776a; }
  .code { margin: 0; padding: 20px 20px 24px; font-size: clamp(.68rem, 1.05vw, .84rem); line-height: 1.75; color: #e9e1d0; overflow-x: auto; white-space: pre; }
  .code .c { color: #7d7363; font-style: italic; }
  .code .k { color: #c9a96e; }
  .code .f { color: #e3cfa3; }
  .code .s { color: #b08d57; }
  .cursor { display: inline-block; width: 8px; height: 1.1em; background: #c9a96e; vertical-align: text-bottom; margin-left: 2px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .float {
    position: absolute; display: flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 12px; font-size: .76rem;
    background: var(--bg-elev); border: 1px solid var(--border); box-shadow: var(--shadow-lg); color: var(--text); white-space: nowrap;
    animation: float 6s ease-in-out infinite;
  }
  .ok { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .f1 { top: -18px; right: 18px; }
  .f2 { bottom: -22px; left: 24px; animation-delay: -3s; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  .avatar-card {
    position: absolute; right: -10px; bottom: -34px; display: flex; align-items: center; gap: 12px; padding: 10px 16px 10px 10px;
    border-radius: 16px; background: var(--bg-elev); border: 1px solid var(--border); box-shadow: var(--shadow-lg);
  }
  .avatar-card img { width: 48px; height: 48px; border-radius: 12px; object-fit: cover; }
  .avatar-card strong { display: block; font-size: .9rem; }
  .avatar-card span { font-size: .72rem; color: var(--text-muted); }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
    .br-lg { display: none; }
    .visual { margin-top: 18px; }
    .window { transform: none; }
    .f2 { left: 8px; }
  }
  @media (max-width: 520px) {
    .ctas .btn { flex: 1 1 auto; justify-content: center; }
    .f1 { right: 8px; top: -16px; }
    .f2 { display: none; }
    .avatar-card { right: 8px; bottom: -28px; max-width: calc(100% - 16px); }
    .status { font-size: .72rem; }
  }
</style>
