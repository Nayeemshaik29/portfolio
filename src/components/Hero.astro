---
import Icon from './Icon.astro';
import Scene3D from './react/Scene3D';
import RotatingWords from './react/RotatingWords';
import { profile } from '../data/profile';
const stack = ['Java', 'Spring Boot', 'Microservices', 'Apache Kafka', 'PostgreSQL', 'Redis', 'Docker', 'AWS', 'Spring Security', 'Resilience4j', 'MongoDB', 'GitHub Actions', 'Zipkin', 'React'];
---
<section class="relative isolate -mt-[68px] overflow-hidden pt-[68px]">
  <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10"></div>

  <div class="container-x relative grid min-h-[calc(100svh-68px)] items-center gap-6 pb-16 lg:grid-cols-[1.05fr_1fr]">
    <!-- 3D: behind the text on phones, beside it on desktop -->
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[62svh] opacity-50 lg:pointer-events-auto lg:static lg:order-2 lg:h-[620px] lg:opacity-100">
      <Scene3D client:only="react" variant="hero">
        <div slot="fallback" class="size-full"></div>
      </Scene3D>
    </div>

    <div class="pt-[30svh] lg:pt-0">
      <p class="eyebrow animate-in fade-in slide-in-from-bottom-2 duration-700 fill-mode-both">
        <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-success"></span></span>
        Open to backend roles &amp; freelance · {profile.location}
      </p>
      <h1 class="mt-6 text-[clamp(2.6rem,7vw,5.2rem)] leading-[0.98] font-semibold tracking-tighter text-balance">
        <span class="block animate-in fade-in slide-in-from-bottom-4 delay-100 duration-700 fill-mode-both">Hi, I'm {profile.shortName}.</span>
        <span class="text-metal block animate-in fade-in slide-in-from-bottom-4 delay-200 duration-700 fill-mode-both">I build backends that don't break.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-pretty text-muted-foreground animate-in fade-in slide-in-from-bottom-4 delay-300 duration-700 fill-mode-both">
        {profile.role} working with{' '}<RotatingWords client:visible words={['Java', 'Spring Boot', 'microservices', 'Apache Kafka', 'secure APIs']} />.{' '}{profile.pitch}
      </p>
      <div class="mt-8 flex flex-wrap gap-3 animate-in fade-in slide-in-from-bottom-4 delay-500 duration-700 fill-mode-both">
        <a href="#projects" class="inline-flex h-12 items-center gap-2 rounded-full bg-primary px-6 font-medium text-primary-foreground shadow-[0_8px_30px_-8px_rgba(255,255,255,.4)] transition hover:-translate-y-0.5">View my work <Icon name="arrow" size={16} /></a>
        <a href="/freelance" class="inline-flex h-12 items-center gap-2 rounded-full border bg-background/40 px-6 font-medium backdrop-blur transition hover:-translate-y-0.5 hover:bg-accent"><Icon name="sparkles" size={16} /> Hire me / Freelance</a>
        <a href="/resume.pdf" target="_blank" rel="noopener" class="inline-flex h-12 items-center gap-2 rounded-full px-4 font-medium text-muted-foreground transition hover:text-foreground"><Icon name="download" size={16} /> Resume</a>
      </div>
      <div class="mt-10 flex items-center gap-4 animate-in fade-in delay-700 duration-1000 fill-mode-both">
        <img src="/avatar.jpg" alt="" width="44" height="44" class="size-11 rounded-full border object-cover grayscale" />
        <div class="text-sm leading-tight">
          <p class="font-medium">{profile.name}</p>
          <p class="font-mono text-xs text-muted-foreground">Associate SWE @ LTM · KL University '25</p>
        </div>
      </div>
    </div>
  </div>

  <!-- tech marquee -->
  <div class="relative border-y bg-card/30 py-4 [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]" aria-label="Tech stack">
    <div class="flex w-max animate-marquee gap-10 hover:[animation-play-state:paused]">
      {[...stack, ...stack].map((s, i) => (
        <span class="flex items-center gap-10 font-mono text-sm whitespace-nowrap text-muted-foreground" aria-hidden={i >= stack.length ? 'true' : undefined}>
          {s}<span class="text-white/20">✦</span>
        </span>
      ))}
    </div>
  </div>
</section>
