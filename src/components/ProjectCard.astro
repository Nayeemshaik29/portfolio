---
import Icon from './Icon.astro';
interface Props {
  slug: string;
  title: string;
  tagline: string;
  summary: string;
  stack: readonly string[];
  repo: string;
  status: string;
  category: string;
  index: number;
}
const { slug, title, tagline, summary, stack, repo, status, category, index } = Astro.props;
---
<article
  class="spotlight reveal group relative flex flex-col gap-3 overflow-hidden rounded-2xl border bg-card/60 p-6 transition duration-500 hover:-translate-y-1 hover:border-white/20"
  data-category={category}
  data-delay={(index % 3) * 80}
>
  <div class="flex items-center justify-between">
    <span class="font-mono text-xs text-muted-foreground">{String(index + 1).padStart(2, '0')} / {category}</span>
    <span class="rounded-full border px-2.5 py-0.5 text-[11px] text-muted-foreground">{status}</span>
  </div>
  <h3 class="mt-2 text-2xl font-semibold tracking-tight">
    <a href={`/projects/${slug}`} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class="font-medium text-foreground/90">{tagline}</p>
  <p class="flex-1 text-sm text-muted-foreground">{summary}</p>
  <div class="flex flex-wrap gap-1.5">
    {stack.slice(0, 5).map((s) => <span class="rounded-md bg-secondary px-2 py-0.5 font-mono text-[11px] text-secondary-foreground">{s}</span>)}
  </div>
  <div class="mt-3 flex items-center justify-between border-t pt-4">
    <span class="inline-flex items-center gap-1.5 text-sm font-medium">Case study <Icon name="arrow" size={15} class="transition group-hover:translate-x-1" /></span>
    <a href={repo} target="_blank" rel="noopener" aria-label={`${title} on GitHub`} class="relative z-10 grid size-9 place-items-center rounded-full text-muted-foreground transition hover:bg-accent hover:text-foreground">
      <Icon name="github" size={17} />
    </a>
  </div>
</article>
