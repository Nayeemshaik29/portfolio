---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <section class="relative isolate grid min-h-[70svh] place-items-center overflow-hidden text-center">
    <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10"></div>
    <div class="container-x">
      <p class="text-metal font-mono text-[clamp(6rem,22vw,12rem)] leading-none font-medium tracking-tighter">404</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight">This endpoint returned nothing.</h1>
      <p class="lead mx-auto">The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="mt-8 inline-flex h-11 items-center gap-2 rounded-full bg-primary px-6 font-medium text-primary-foreground transition hover:-translate-y-0.5">Back home <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Base>
