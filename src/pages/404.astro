---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <section class="section nf">
    <div class="container">
      <p class="code mono gradient-text">404</p>
      <h1 class="section-title">This endpoint returned nothing.</h1>
      <p class="section-lead">The page you're looking for doesn't exist or has moved.</p>
      <a class="btn btn-primary" href="/">Back home <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
<style>
  .nf { text-align: center; min-height: 60vh; display: grid; place-items: center; }
  .code { font-size: clamp(5rem, 18vw, 9rem); font-weight: 500; line-height: 1; margin-bottom: 12px; }
  .section-lead { margin: 0 auto 28px; }
</style>
