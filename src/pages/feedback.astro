---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { careerServices } from '../data/services';
import { feedbackConfig } from '../data/feedback';

const services = [...careerServices.map((s) => s.title), 'Development project'];
---
<Base title="Client feedback" description="Feedback for clients who booked a service.">
  <section class="relative isolate grid min-h-[75svh] place-items-center overflow-hidden py-16">
    <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10"></div>
    <div class="container-x max-w-2xl">
      <div class="rounded-3xl border bg-card/60 p-7 backdrop-blur sm:p-10 animate-in fade-in zoom-in-95 duration-700">
        <p class="eyebrow">Clients only</p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tighter">Share your <span class="text-metal">feedback</span></h1>
        <p class="mt-3 text-muted-foreground">This page is for clients who booked a service. Enter the feedback code I sent you after delivery.</p>

        <form id="gate" class="mt-8 grid gap-3" data-hashes={JSON.stringify(feedbackConfig.clientCodeHashes)}>
          <label for="code" class="text-sm font-medium">Feedback code</label>
          <div class="flex flex-col gap-3 sm:flex-row">
            <input id="code" name="code" placeholder="NS-XXXXXX" autocomplete="off" required class="field flex-1 uppercase" />
            <button class="btn-p" type="submit">Continue</button>
          </div>
          <p class="text-sm text-destructive" id="gate-err" hidden>That code doesn't match a booking. Check the code in my message, or reach me on WhatsApp.</p>
        </form>

        <form id="fb" class="mt-8 grid gap-5" hidden data-key={feedbackConfig.web3formsKey} data-email={profile.email}>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="lbl">Your name<input name="name" required maxlength="80" class="field" /></label>
            <label class="lbl">Role / college (optional)<input name="role" maxlength="80" placeholder="e.g. Java Developer, KLU '25" class="field" /></label>
          </div>
          <label class="lbl">Service you booked
            <select name="service" required class="field">
              {services.map((s) => <option>{s}</option>)}
            </select>
          </label>
          <fieldset class="grid gap-2">
            <legend class="mb-2 text-sm font-medium">Rating</legend>
            <div class="flex flex-wrap gap-2">
              {[5, 4, 3, 2, 1].map((n) => (
                <label class="cursor-pointer rounded-full border px-3 py-1.5 text-sm tracking-widest transition has-[:checked]:border-white/60 has-[:checked]:bg-accent"><input type="radio" name="rating" value={n} required checked={n === 5} class="sr-only" />{'★'.repeat(n)}</label>
              ))}
            </div>
          </fieldset>
          <label class="lbl">Your feedback<textarea name="message" rows="5" required maxlength="1200" placeholder="What did you like? Did it help you get calls or interviews?" class="field"></textarea></label>
          <label class="flex items-start gap-3 text-sm text-muted-foreground"><input type="checkbox" name="publish" value="yes" class="mt-1 accent-white" /> You can show this feedback (with my name) on your website.</label>
          <button class="btn-p" type="submit"><Icon name="mail" size={16} /> Send feedback</button>
          <p class="text-sm text-destructive" id="fb-err" hidden>Couldn't send. Please try again, or message me on WhatsApp.</p>
        </form>

        <div id="thanks" class="mt-8 grid justify-items-center gap-3 text-center" hidden>
          <span class="grid size-14 place-items-center rounded-full bg-primary text-primary-foreground"><Icon name="check" size={26} /></span>
          <h2 class="text-2xl font-semibold">Thank you!</h2>
          <p class="text-muted-foreground">Your feedback means a lot and helps other job seekers trust my work.</p>
          <a class="btn-p" href="/">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const gate = document.querySelector<HTMLFormElement>('#gate')!;
  const form = document.querySelector<HTMLFormElement>('#fb')!;
  const thanks = document.querySelector<HTMLElement>('#thanks')!;
  const hashes: string[] = JSON.parse(gate.dataset.hashes || '[]');
  let code = '';

  const sha256 = async (s: string) => {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
  };

  const open = async (value: string) => {
    code = value.trim().toUpperCase();
    const ok = code && hashes.includes(await sha256(code));
    document.querySelector<HTMLElement>('#gate-err')!.hidden = !!ok;
    if (ok) { gate.hidden = true; form.hidden = false; }
  };

  gate.addEventListener('submit', (e) => { e.preventDefault(); open(new FormData(gate).get('code') as string); });
  const fromUrl = new URLSearchParams(location.search).get('code');
  if (fromUrl) { (gate.querySelector('#code') as HTMLInputElement).value = fromUrl; open(fromUrl); }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const summary =
      `Name: ${d.name}\nRole: ${d.role || '-'}\nService: ${d.service}\nRating: ${d.rating}/5\nOK to publish: ${d.publish ? 'Yes' : 'No'}\nCode: ${code}\n\n${d.message}`;
    const key = form.dataset.key;
    if (!key) {
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Client feedback: ' + d.name)}&body=${encodeURIComponent(summary)}`;
      return;
    }
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: `Client feedback: ${d.name} (${d.rating}/5)`,
          from_name: 'Portfolio feedback',
          name: d.name, role: d.role, service: d.service, rating: d.rating,
          publish: d.publish ? 'Yes' : 'No', code, message: d.message,
        }),
      });
      if (!(await res.json()).success) throw new Error('send failed');
      form.hidden = true; thanks.hidden = false;
    } catch {
      document.querySelector<HTMLElement>('#fb-err')!.hidden = false;
    }
  });
</script>

<style>
  @reference '../styles/global.css';
  .field { @apply w-full rounded-xl border border-input bg-background/60 px-4 py-3 text-base font-normal text-foreground outline-none transition placeholder:text-muted-foreground/60 focus:border-white/40 focus:ring-[3px] focus:ring-ring/30; }
  .lbl { @apply grid gap-2 text-sm font-medium; }
  .btn-p { @apply inline-flex h-12 items-center justify-center gap-2 rounded-full bg-primary px-6 font-medium text-primary-foreground transition hover:-translate-y-0.5; }
</style>
