---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { readingMinutes } from '../../lib/reading';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
---
<Base title="Blog" description="Notes on Java, Spring Boot, Kafka, microservices, databases and CI/CD — written while building real systems.">
  <section class="section top">
    <div class="bg-grid"></div>
    <div class="container">
      <div class="section-head">
        <h1 class="section-title">Notes from building things</h1>
        <p class="section-lead">Write-ups of the hard parts: keeping money correct across services, event-driven design with Kafka, database performance and shipping with CI/CD.</p>
        <div class="chips tags">{tags.map((t) => <span class="chip">#{t}</span>)}</div>
      </div>
      <div class="list">
        {posts.map((p) => (
          <PostCard slug={p.id} title={p.data.title} description={p.data.description} date={p.data.pubDate} tags={p.data.tags} minutes={readingMinutes(p.body)} />
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .top { padding-top: clamp(48px, 7vw, 88px); overflow: hidden; }
  .top .container { position: relative; z-index: 1; }
  .tags { margin-top: 20px; }
  .list { display: grid; gap: 20px; grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 760px) { .list { grid-template-columns: 1fr; } }
</style>
