---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { readingMinutes } from '../../lib/reading';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
---
<Base title="Blog" description="Notes on Java, Spring Boot, Kafka, microservices, databases and CI/CD — written while building real systems.">
  <section class="relative isolate overflow-hidden pt-16 pb-24 sm:pt-24">
    <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10"></div>
    <div class="container-x">
      <p class="eyebrow animate-in fade-in duration-700">Blog · {posts.length} posts</p>
      <h1 class="mt-6 max-w-3xl text-5xl font-semibold tracking-tighter text-balance sm:text-6xl animate-in fade-in slide-in-from-bottom-4 duration-700">Notes from <span class="text-metal">building things</span></h1>
      <p class="lead animate-in fade-in slide-in-from-bottom-4 delay-150 duration-700 fill-mode-both">Write-ups of the hard parts: keeping money correct across services, event-driven design with Kafka, database performance and shipping with CI/CD.</p>
      <div class="mt-6 flex flex-wrap gap-2">{tags.map((t) => <span class="rounded-full border px-3 py-1 font-mono text-xs text-muted-foreground">#{t}</span>)}</div>
      <div class="mt-14 grid gap-5 md:grid-cols-2">
        {posts.map((p, i) => (
          <PostCard slug={p.id} title={p.data.title} description={p.data.description} date={p.data.pubDate} tags={p.data.tags} minutes={readingMinutes(p.body)} delay={(i % 2) * 80} />
        ))}
      </div>
    </div>
  </section>
</Base>
