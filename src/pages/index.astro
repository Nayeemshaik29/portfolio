---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import FreelanceBand from '../components/FreelanceBand.astro';
import VisitorWall from '../components/VisitorWall.astro';
import CountUp from '../components/react/CountUp';
import { profile, moreRepos } from '../data/profile';
import repos from '../data/repos.json';
import { readingMinutes } from '../lib/reading';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const categories = ['All', ...new Set(projects.map((p) => p.data.category))];
const extra = moreRepos
  .map((n) => repos.find((r) => r.name === n))
  .filter((r): r is (typeof repos)[number] => Boolean(r));
---
<Base>
  <Hero />

  <!-- About -->
  <section id="about" class="section-y">
    <div class="container-x grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div class="reveal">
        <p class="eyebrow">01 · About</p>
        <h2 class="h-section mt-5">Backend engineer with a <span class="text-metal">security mindset</span>.</h2>
        <div class="mt-6 grid gap-4 text-lg text-muted-foreground">
          {profile.about.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-10 grid grid-cols-3 gap-3">
          {profile.stats.map((s) => (
            <div class="rounded-2xl border bg-card/60 p-4 sm:p-5">
              <CountUp client:visible value={s.value} className="block text-3xl font-semibold tracking-tighter sm:text-4xl" />
              <span class="mt-1 block text-xs text-muted-foreground sm:text-sm">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="reveal grid content-start gap-3" data-delay="120">
        {[
          { icon: 'cap', t: profile.education.degree, d: `${profile.education.school} · ${profile.education.period} · ${profile.education.detail}` },
          ...profile.certifications.map((c) => ({ icon: c.name.includes('Ethical') ? 'shield' : 'award', t: c.name, d: c.issuer })),
          { icon: 'pin', t: profile.location, d: 'Open to on-site, hybrid & remote · any shift' },
        ].map((r) => (
          <div class="spotlight flex gap-4 rounded-2xl border bg-card/60 p-5 transition hover:border-white/20">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl border bg-secondary"><Icon name={r.icon} size={19} /></span>
            <div><p class="font-medium">{r.t}</p><p class="text-sm text-muted-foreground">{r.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="section-y border-y bg-card/20">
    <div class="container-x">
      <div class="reveal">
        <p class="eyebrow">02 · Experience</p>
        <h2 class="h-section mt-5">Where I've worked</h2>
      </div>
      <ol class="relative mt-12 grid gap-6 before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-px before:bg-gradient-to-b before:from-white/40 before:to-transparent md:before:left-[183px]">
        {profile.experience.map((e, i) => (
          <li class="reveal relative grid gap-3 pl-8 md:grid-cols-[160px_1fr] md:gap-12 md:pl-0" data-delay={i * 100}>
            <span class="absolute top-1.5 left-0 size-[15px] rounded-full border-2 border-white/60 bg-background md:left-[176px]"></span>
            <p class="pt-1 font-mono text-xs text-muted-foreground">{e.period}</p>
            <div class="spotlight rounded-2xl border bg-card/60 p-6 transition hover:border-white/20">
              <h3 class="text-xl font-semibold tracking-tight">{e.role} <span class="text-muted-foreground">@ {e.company}</span></h3>
              <p class="mt-1 flex items-center gap-1.5 text-sm text-muted-foreground"><Icon name="pin" size={13} /> {e.location}</p>
              <ul class="mt-4 grid gap-2 text-[0.95rem] text-muted-foreground">
                {e.points.map((p) => <li class="flex gap-3"><span class="mt-2.5 size-1 shrink-0 rounded-full bg-white/50"></span>{p}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="section-y">
    <div class="container-x">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">03 · Work</p>
          <h2 class="h-section mt-5">Systems I've designed and built</h2>
          <p class="lead">Production-style projects focused on correctness, resilience and clean service boundaries, each with an architecture write-up.</p>
        </div>
        <div class="flex max-w-full gap-1 overflow-x-auto rounded-full border bg-card/70 p-1" role="group" aria-label="Filter projects">
          {categories.map((c, i) => (
            <button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}
              class="shrink-0 rounded-full px-4 py-1.5 text-sm text-muted-foreground transition hover:text-foreground aria-pressed:bg-primary aria-pressed:text-primary-foreground">{c}</button>
          ))}
        </div>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-projects>
        {projects.map((p, i) => <ProjectCard slug={p.id} index={i} {...p.data} />)}
      </div>

      <div class="mt-20">
        <h3 class="reveal text-xl font-semibold tracking-tight">More on GitHub</h3>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {extra.map((r, i) => (
            <a href={r.url} target="_blank" rel="noopener" class="reveal group flex flex-col gap-2 rounded-xl border bg-card/40 p-5 transition hover:border-white/20 hover:bg-card/80" data-delay={(i % 3) * 60}>
              <span class="flex items-center gap-2 text-sm font-medium">
                <Icon name="github" size={15} />
                <span class="flex-1 capitalize">{r.name.replace(/[-_]/g, ' ')}</span>
                <Icon name="external" size={13} class="text-muted-foreground transition group-hover:text-foreground" />
              </span>
              <span class="line-clamp-2 text-sm text-muted-foreground">{r.description}</span>
              {r.language && <span class="font-mono text-[11px] text-muted-foreground">{r.language}</span>}
            </a>
          ))}
        </div>
        <a href={profile.links.github} target="_blank" rel="noopener" class="mt-6 inline-flex h-10 items-center gap-2 rounded-full border px-5 text-sm font-medium transition hover:bg-accent"><Icon name="github" size={16} /> All 40 repositories</a>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="section-y border-y bg-card/20">
    <div class="container-x">
      <div class="reveal">
        <p class="eyebrow">04 · Stack</p>
        <h2 class="h-section mt-5">Tech I work with</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {profile.skills.map((g, i) => (
          <div class="spotlight reveal rounded-2xl border bg-card/60 p-6 transition hover:border-white/20" data-delay={(i % 3) * 80}>
            <h3 class="font-mono text-xs tracking-widest text-muted-foreground uppercase">{g.group}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {g.items.map((s) => <span class="rounded-full border bg-background/50 px-3 py-1 text-sm transition hover:border-white/30">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FreelanceBand />

  <!-- Blog -->
  <section id="blog" class="section-y pt-0">
    <div class="container-x">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">05 · Writing</p>
          <h2 class="h-section mt-5">Notes from building things</h2>
          <p class="lead">Deep dives into the problems I hit while building these systems, and how I solved them.</p>
        </div>
        <a href="/blog" class="inline-flex h-10 items-center gap-2 rounded-full border px-5 text-sm font-medium transition hover:bg-accent">All posts <Icon name="arrow" size={15} /></a>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {posts.map((p, i) => (
          <PostCard slug={p.id} title={p.data.title} description={p.data.description} date={p.data.pubDate} tags={p.data.tags} minutes={readingMinutes(p.body)} delay={i * 80} />
        ))}
      </div>
    </div>
  </section>

  <VisitorWall />

  <!-- Contact -->
  <section id="contact" class="section-y pt-0">
    <div class="container-x">
      <div class="reveal relative overflow-hidden rounded-3xl border bg-card/40 px-6 py-16 text-center sm:px-12 sm:py-24">
        <div aria-hidden="true" class="bg-grid absolute inset-0"></div>
        <div aria-hidden="true" class="absolute -bottom-40 left-1/2 size-[520px] -translate-x-1/2 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative">
          <h2 class="mx-auto max-w-3xl text-4xl font-semibold tracking-tighter text-balance sm:text-6xl">Let's build something <span class="text-metal">reliable</span>.</h2>
          <p class="lead mx-auto">I'm open to Java backend and full-stack roles, and I take on <a href="/freelance" class="text-foreground underline underline-offset-4">freelance work</a> too. Email or LinkedIn is the fastest way to reach me.</p>
          <div class="mt-9 flex flex-wrap justify-center gap-3">
            <a href={`mailto:${profile.email}`} class="inline-flex h-12 max-w-full items-center gap-2 rounded-full bg-primary px-6 font-medium break-all text-primary-foreground transition hover:-translate-y-0.5"><Icon name="mail" size={16} /> {profile.email}</a>
            <a href={profile.links.linkedin} target="_blank" rel="noopener" class="inline-flex h-12 items-center gap-2 rounded-full border bg-background/40 px-6 font-medium transition hover:bg-accent"><Icon name="linkedin" size={16} /> LinkedIn</a>
            <a href={profile.links.github} target="_blank" rel="noopener" class="inline-flex h-12 items-center gap-2 rounded-full border bg-background/40 px-6 font-medium transition hover:bg-accent"><Icon name="github" size={16} /> GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-projects] > [data-category]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const f = b.dataset.filter;
      cards.forEach((c) => (c.hidden = f !== 'All' && c.dataset.category !== f));
    }),
  );
</script>
