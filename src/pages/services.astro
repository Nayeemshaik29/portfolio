---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { services, process, faqs } from '../data/services';

const mail = (subject: string) =>
  `mailto:${profile.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(
    "Hi Nayeem,\n\nWhat I need:\n\nDeadline / budget (rough is fine):\n\nLinks (site, repo, docs):\n",
  )}`;
---
<Base
  title="Services"
  description="Freelance Java backend, AI assistant, CI/CD and website development. Fixed quotes, milestone payments and clean handover."
>
  <section class="section top">
    <div class="bg-grid"></div>
    <div class="container">
      <div class="section-head hero">
        <h1 class="section-title">I build the backend, <span class="gradient-text">you ship the product</span>.</h1>
        <p class="section-lead">
          Need an API for your app, an AI assistant for your business or a pipeline that deploys itself? I'll build it with the
          same care as my production-style systems: correct, secure and documented.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href={mail('Project enquiry')}><Icon name="mail" /> Start a project</a>
          <a class="btn" href="#packages">See packages <Icon name="arrow" /></a>
        </div>
        <ul class="trust">
          <li><Icon name="check" size={16} /> Fixed quotes, no surprises</li>
          <li><Icon name="check" size={16} /> Reply within 24 hours</li>
          <li><Icon name="check" size={16} /> You own 100% of the code</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="packages" class="section packages">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">What I can build for you</h2>
        <p class="section-lead">Starting prices for a typical scope. Every project gets a fixed quote after a short call.</p>
      </div>
      <div class="grid svc-grid">
        {services.map((s) => (
          <article class:list={['card svc reveal', { featured: s.featured }]}>
            {s.featured && <span class="badge mono">Most requested</span>}
            <span class="ic"><Icon name={s.icon} size={22} /></span>
            <h3>{s.title}</h3>
            <p class="muted blurb">{s.blurb}</p>
            <div class="price">
              <span class="from">from</span>
              <strong>{s.price.inr}</strong>
              <span class="usd mono">/ {s.price.usd}</span>
            </div>
            <p class="time"><Icon name="clock" size={15} /> {s.timeline}</p>
            <ul class="incl">
              {s.includes.map((i) => <li><Icon name="check" size={16} /> {i}</li>)}
            </ul>
            <div class="svc-foot">
              <a class:list={['btn', { 'btn-primary': s.featured }]} href={mail(`Enquiry: ${s.title}`)}>Get a quote</a>
              <a class="proof" href={s.proof.href}>See: {s.proof.label} <Icon name="arrow" size={14} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">Simple, transparent process</h2>
      </div>
      <ol class="grid steps">
        {process.map((p, i) => (
          <li class="card step reveal">
            <span class="num mono gradient-text">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p class="muted">{p.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div class="reveal">
        <h2 class="section-title">Common questions</h2>
        <p class="section-lead">Something else on your mind? Just ask, I'm happy to talk it through before you commit to anything.</p>
      </div>
      <div class="faqs reveal">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact card reveal">
        <div class="bg-grid"></div>
        <h2 class="section-title">Have a project in mind?</h2>
        <p class="section-lead">Tell me what you're building and when you need it. I'll reply within a day with questions or a rough quote.</p>
        <div class="ctas center">
          <a class="btn btn-primary" href={mail('Project enquiry')}><Icon name="mail" /> {profile.email}</a>
          <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> Message on LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .top { padding-top: clamp(48px, 7vw, 88px); padding-bottom: 0; overflow: hidden; }
  .top .container { position: relative; z-index: 1; }
  .hero { margin-bottom: 0; }
  .hero .section-title { font-size: clamp(2.1rem, 5vw, 3.4rem); max-width: 820px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .ctas.center { justify-content: center; margin-top: 0; }
  .trust { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: .92rem; color: var(--text-muted); }
  .trust li { display: inline-flex; align-items: center; gap: 8px; }
  .trust :global(svg) { color: var(--accent); }

  .packages { padding-top: clamp(56px, 8vw, 96px); }
  .grid { display: grid; gap: 22px; }
  .grid > * { min-width: 0; }
  .svc-grid { grid-template-columns: repeat(2, 1fr); }
  .svc { position: relative; padding: 28px; display: flex; flex-direction: column; }
  .svc.featured { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 18px 48px var(--glow); }
  .badge {
    position: absolute; top: 20px; right: 20px; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase;
    padding: .35em .8em; border-radius: 999px; background: linear-gradient(100deg, var(--accent), var(--accent-2)); color: var(--accent-ink);
  }
  .ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--bg-soft); color: var(--accent); margin-bottom: 18px; }
  .svc h3 { font-size: 1.3rem; margin-bottom: 8px; padding-right: 120px; }
  .svc:not(.featured) h3 { padding-right: 0; }
  .blurb { font-size: .97rem; }
  .price { display: flex; align-items: baseline; gap: 8px; margin-top: 4px; }
  .from { font-size: .82rem; color: var(--text-faint); }
  .price strong { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; }
  .usd { font-size: .9rem; color: var(--text-muted); }
  .time { display: flex; align-items: center; gap: 6px; font-size: .88rem; color: var(--text-muted); margin: 4px 0 18px; }
  .incl { list-style: none; padding: 18px 0 0; margin: 0 0 24px; border-top: 1px solid var(--border); display: grid; gap: 10px; font-size: .95rem; flex: 1; }
  .incl li { display: flex; gap: 10px; align-items: flex-start; }
  .incl :global(svg) { flex: none; color: var(--accent); margin-top: 4px; }
  .svc-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .proof { display: inline-flex; align-items: center; gap: 6px; font-size: .88rem; color: var(--accent-2); font-weight: 500; }
  .proof:hover { text-decoration: underline; text-underline-offset: 3px; }

  .alt { background: linear-gradient(180deg, transparent, var(--bg-soft) 18%, var(--bg-soft) 82%, transparent); }
  .steps { list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(4, 1fr); }
  .step { padding: 24px; }
  .step:hover { transform: none; }
  .num { display: block; font-size: 1.6rem; font-weight: 600; margin-bottom: 12px; }
  .step h3 { font-size: 1.08rem; margin-bottom: 8px; }
  .step p { font-size: .93rem; margin: 0; }

  .faq-wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .faq-wrap > * { min-width: 0; }
  .faqs { display: grid; gap: 12px; }
  .faq { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-elev); padding: 0 20px; transition: border-color .2s; }
  .faq[open] { border-color: var(--border-strong); }
  .faq summary {
    list-style: none; cursor: pointer; padding: 18px 0; font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 16px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 14px; height: 14px; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; border-radius: 2px; background: var(--accent); transition: transform .25s var(--ease); }
  .plus::after { transform: rotate(90deg); }
  .faq[open] .plus::after { transform: rotate(0deg); }
  .faq p { margin: 0 0 18px; font-size: .96rem; }

  .contact { position: relative; overflow: hidden; padding: clamp(36px, 6vw, 72px); text-align: center; }
  .contact:hover { transform: none; }
  .contact > * { position: relative; }
  .contact .section-lead { margin-inline: auto; margin-bottom: 28px; }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
    .faq-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .svc-grid, .steps { grid-template-columns: 1fr; }
    .svc { padding: 22px; }
    .svc h3 { padding-right: 0; }
    .badge { position: static; align-self: flex-start; margin-bottom: 14px; }
    .ctas .btn { flex: 1 1 auto; justify-content: center; }
    .contact .btn { width: 100%; justify-content: center; white-space: normal; word-break: break-all; }
  }
</style>
