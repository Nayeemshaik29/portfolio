---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import VisitorHi from '../components/VisitorHi.astro';
import Analytics from '@vercel/analytics/astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}
const {
  title,
  description = `${profile.name} — ${profile.role}. ${profile.pitch}`,
  image = '/og-v2.png',
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: 'LTM' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'KL University' },
  address: { '@type': 'PostalAddress', addressLocality: 'Hyderabad', addressCountry: 'IN' },
  url: Astro.site?.toString(),
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.leetcode],
};
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Blog`} href="/rss.xml" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500&display=swap" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body class="noise min-h-dvh">
    <a href="#main" class="fixed top-3 left-3 z-[200] -translate-y-20 rounded-full bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition focus:translate-y-0">Skip to content</a>
    <!-- ambient light at the top of every page -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[60vh] bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,rgba(255,255,255,.09),transparent)]"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <VisitorHi />
    <Analytics />

    <script>
      // Scroll reveal for elements with .reveal (optional --d delay in ms via data-delay).
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
        if (el.dataset.delay) el.style.transitionDelay = el.dataset.delay + 'ms';
        io.observe(el);
      });

      // Spotlight cards: light follows the cursor.
      document.addEventListener('pointermove', (e) => {
        const t = (e.target as HTMLElement | null)?.closest<HTMLElement>('.spotlight');
        if (!t) return;
        const r = t.getBoundingClientRect();
        t.style.setProperty('--mx', `${e.clientX - r.left}px`);
        t.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });
    </script>
  </body>
</html>
